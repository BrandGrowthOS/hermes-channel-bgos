index e7a22dfb..f287a0c7 100644
--- a/cron/scheduler.py
+++ b/cron/scheduler.py
@@ -46,7 +46,7 @@ _KNOWN_DELIVERY_PLATFORMS = frozenset({
     "telegram", "discord", "slack", "whatsapp", "signal",
     "matrix", "mattermost", "homeassistant", "dingtalk", "feishu",
     "wecom", "wecom_callback", "weixin", "sms", "email", "webhook", "bluebubbles",
-    "qqbot",
+    "qqbot", "bgos",
 })
 
 # Platforms that support a configured cron/notification home target, mapped to
@@ -306,6 +306,7 @@ def _deliver_result(job: dict, content: str, adapters=None, loop=None) -> Option
         "sms": Platform.SMS,
         "bluebubbles": Platform.BLUEBUBBLES,
         "qqbot": Platform.QQBOT,
+        "bgos": Platform.BGOS,
     }
 
     # Optionally wrap the content with a header/footer so the user knows this
diff --git a/gateway/config.py b/gateway/config.py
index 67ebf734..a8336d92 100644
--- a/gateway/config.py
+++ b/gateway/config.py
@@ -67,6 +67,7 @@ class Platform(Enum):
     WEIXIN = "weixin"
     BLUEBUBBLES = "bluebubbles"
     QQBOT = "qqbot"
+    BGOS = "bgos"
 
 
 @dataclass
@@ -1271,6 +1272,40 @@ def _apply_env_overrides(config: GatewayConfig) -> None:
                 name=os.getenv("QQBOT_HOME_CHANNEL_NAME") or os.getenv(qq_home_name_env, "Home"),
             )
 
+    # BGOS
+    bgos_api_key = os.getenv("BGOS_API_KEY")
+    if not bgos_api_key:
+        # Fall back to the secrets file written by `hermes-pair-bgos`
+        # so users don't have to manually copy the pairing token into
+        # systemd env after pairing. Matches the adapter's own
+        # BgosConfig resolution order (see hermes-channel-bgos/src/
+        # hermes_channel_bgos/bgos_adapter.py::_resolve_config).
+        try:
+            bgos_home_dir = Path(os.environ.get("HERMES_HOME", str(Path.home() / ".hermes")))
+            bgos_secrets_file = bgos_home_dir / "secrets" / "bgos.json"
+            if bgos_secrets_file.is_file():
+                bgos_api_key = json.loads(bgos_secrets_file.read_text()).get("pairing_token")
+        except Exception:
+            # Fail silently — if the secrets file is unreadable, user
+            # can still provide BGOS_API_KEY via env.
+            bgos_api_key = None
+    if bgos_api_key:
+        if Platform.BGOS not in config.platforms:
+            config.platforms[Platform.BGOS] = PlatformConfig()
+        config.platforms[Platform.BGOS].enabled = True
+        config.platforms[Platform.BGOS].api_key = bgos_api_key
+        bgos_backend_url = os.getenv("BGOS_BACKEND_URL", "").strip()
+        if bgos_backend_url:
+            config.platforms[Platform.BGOS].extra["backend_url"] = bgos_backend_url
+
+    bgos_home = os.getenv("BGOS_HOME_CHANNEL")
+    if bgos_home and Platform.BGOS in config.platforms:
+        config.platforms[Platform.BGOS].home_channel = HomeChannel(
+            platform=Platform.BGOS,
+            chat_id=bgos_home,
+            name=os.getenv("BGOS_HOME_CHANNEL_NAME", "Home"),
+        )
+
     # Session settings
     idle_minutes = os.getenv("SESSION_IDLE_MINUTES")
     if idle_minutes:
diff --git a/gateway/platforms/bgos.py b/gateway/platforms/bgos.py
new file mode 100644
index 00000000..82446107
--- /dev/null
+++ b/gateway/platforms/bgos.py
@@ -0,0 +1,6 @@
+"""BGOS channel adapter — thin shim. Real logic lives in the
+hermes-channel-bgos pip package (install separately).
+"""
+from hermes_channel_bgos.bgos_adapter import BGOSAdapter
+
+__all__ = ["BGOSAdapter"]
